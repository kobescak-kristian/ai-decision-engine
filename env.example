# AI Decision Engine — environment variables
# Copy this to .env and fill in your values

# OpenAI (optional). Leave empty to run in SIMULATION MODE: the demo
# dataset is classified from built-in simulated outputs and no API calls
# are made. Set a real key to classify leads with the live model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Pipeline thresholds
CONFIDENCE_THRESHOLD=0.60

# Evaluation thresholds (used by the insights engine)
MIN_CONVERSION_RATE=0.40
MAX_FALSE_POSITIVE_RATE=0.30
MAX_MANUAL_REVIEW_RATE=0.25

# Database
DB_PATH=data/decisions.db
